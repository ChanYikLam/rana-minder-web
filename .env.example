# 认证模式：mock（默认，浏览器内 Mock 身份）/ oidc（Casdoor 重定向）/ disabled（禁用）
VITE_AUTH_MODE=mock

# API 基础路径（前端运行时请求前缀；同源部署 / 网关转发场景保持 /api 即可）
VITE_API_BASE_URL=/api

# 是否启用浏览器内 Mock（on=默认 mock；off=卸载 mock 插件，走真实后端代理）
VITE_USE_MOCK=on

# 开发环境 Vite /api 代理目标（仅 VITE_USE_MOCK=off 时生效）
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
